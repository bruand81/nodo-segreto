.idea/

# VS Code (IDE used for this project) — local editor state, not shared config.
.vscode/

# Claude Code: settings.json is shared/project config and stays tracked;
# settings.local.json holds personal overrides and must not be committed.
.claude/settings.local.json

# Specifica dei requisiti (fonte di verità locale, non da pubblicare nel repo)
istruzioni.md

